# Copy to .env, or fill everything in from the web app's Settings tab instead.
# .env holds secrets: never share it or commit it.

# --- Who is collecting. Sent to every website in the User-Agent. Required.
ORG_NAME=                    # e.g. Acme Research
RESEARCH_CONTACT=

# --- AI provider. LLM_PRESET: claude | qwen | deepseek | zhipu | doubao | custom
LLM_PRESET=claude
ANTHROPIC_API_KEY=          # when LLM_PRESET=claude
LLM_API_KEY=                # for every other provider
LLM_BASE_URL=               # only for LLM_PRESET=custom
CLASSIFY_MODEL=claude-sonnet-4-6
HELPER_MODEL=               # blank = automatic

# --- YouTube Data API v3 (Google Cloud Console). Not reachable from mainland China.
YOUTUBE_API_KEY=

# --- Reddit (optional): a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# REQUIRED. Any long random string (the web app can generate one). Salts the
# username pseudonymisation. Changing it later breaks author linkage across runs.
AUTHOR_SALT=

# Interface language: en | zh
UI_LANGUAGE=en

# Politeness and analysis settings
REQUEST_DELAY=2.0
CLASSIFY_BATCH=20
MIN_CELL=10

# Keys for custom APIs added in the web app are stored here automatically as
# API_KEY_<COUNTRY>_<NAME>=...
